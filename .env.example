# Postgres connection string. Use a disposable/local database outside production.
DATABASE_URI=postgres://postgres:postgres@localhost:5432/globalcomm_dev

# Long random secret used to sign Payload sessions/tokens. Never commit the real value.
PAYLOAD_SECRET=

# Absolute base URL this deployment is served from (used for internal links & preview).
# The public SEO canonical host (https://globalcomm.ma) is a fixed constant, not this var.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret required to enter Next.js Draft Mode / Payload Preview.
PREVIEW_SECRET=

# Vercel Blob token — required in production for persistent media storage.
BLOB_READ_WRITE_TOKEN=

# Feature flag for the Payload MCP AI control plane.
MCP_ENABLED=true

# Optional error monitoring.
SENTRY_DSN=
