# Postgres connection string. Use a disposable/local database outside production.
DATABASE_URI=postgres://postgres:postgres@localhost:5432/globalcomm_dev

# Long random secret used to sign Payload sessions/tokens. Never commit the real value.
PAYLOAD_SECRET=

# Absolute base URL this deployment is served from (used for internal links & preview).
# The public SEO canonical host (https://globalcomm.ma) is a fixed constant, not this var.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret required to enter Next.js Draft Mode / Payload Preview.
PREVIEW_SECRET=

# Vercel Blob token — required in production for persistent media storage.
BLOB_READ_WRITE_TOKEN=

# Feature flag for the Payload MCP AI control plane.
MCP_ENABLED=true

# OAuth gateway used by ChatGPT. Keep disabled until the provider and server-side
# Payload MCP key are configured.
MCP_OAUTH_ENABLED=false

# Exact OAuth issuer, including trailing slash when the provider uses one.
# Example: https://YOUR_TENANT.auth0.com/
MCP_OAUTH_ISSUER=

# Canonical MCP resource identifier. For Auth0, use this exact value as the API identifier.
MCP_OAUTH_RESOURCE=https://mcp.globalcomm.ma

# Required permissions on every ChatGPT OAuth access token.
MCP_OAUTH_SCOPES=cms:read cms:write cms:publish

# Optional comma-separated OAuth subject allowlist. Leave blank to rely on the
# authorization provider's own user/application policy.
MCP_OAUTH_ALLOWED_SUBJECTS=

# Dedicated Payload MCP API key used only by the server-side OAuth gateway.
# Never expose this as NEXT_PUBLIC_* and never send it to ChatGPT.
PAYLOAD_MCP_INTERNAL_KEY=

# Optional error monitoring.
SENTRY_DSN=
